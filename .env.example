# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Your Discord user ID (the bot owner)
# Enable Developer Mode in Discord settings, then right-click your username → Copy User ID
OWNER_DISCORD_ID=your-discord-user-id-here

# PostgreSQL persistence for memory, runtime config, and token leaderboards.
# The default matches the postgres service in docker-compose.yml.
DATABASE_URL=postgres://housebot:housebot@postgres/housebot
# DATABASE_CONNECT_MAX_ATTEMPTS=10
# DATABASE_CONNECT_RETRY_SECS=2
# DATABASE_CONNECT_TIMEOUT_SECS=10

# Optional: Discord server ID for instant deployment slash-command sync.
# If omitted, /deploy, /update, and /rollback are registered globally and may take up to an hour to appear.
# Enable Developer Mode, then right-click the server name → Copy Server ID.
# DEPLOYMENT_GUILD_ID=your-discord-server-id-here

# LLM — OpenAI-compatible endpoint (llama.cpp)
LLM_BASE_URL=http://server-slop:8080/v1
LLM_MODEL=gemma-4-26b-a4b-qat
# LLM_API_KEY=not-required   # llama.cpp doesn't need a real key

# Optional: on-disk state. In deployment-bot deployments DATA_DIR is fixed to
# /app/data by the run command and cannot be overridden from here.
# DATA_DIR=data                 # history, reminders, and skills live under this

# Optional: skills storage
# SKILLS_DIR=/data/skills       # one directory per skill (default <DATA_DIR>/skills)

# Optional: sandbox. The socket is provided by the sandboxd sidecar; the runtime
# override is for dev/CI hosts without gVisor installed.
# SANDBOX_IDLE_TIMEOUT_SECS=300   # idle time before a session's sandbox is destroyed (default 300)
# SANDBOX_SOCKET_PATH=/run/housebot-sandbox/sandbox.sock
# HOUSEBOT_SANDBOX_RUNTIME=runsc  # set to runc for dev/CI (read by sandboxd, not the bot)

# Optional: LLM scheduling limits. These are startup defaults only — once a
# configurer sets a ceiling with /config scheduler, the stored value wins.
# MAX_INFLIGHT_LLM=4            # total concurrent LLM requests (default 4)
# MAX_SUBAGENT_CONCURRENCY=2    # ceiling on concurrent sub-agent requests (default 2)

# Optional: conversation history
# MAX_HISTORY_TURNS=30   # number of user/assistant turn pairs to keep
# MAX_CONTEXT_TOKENS=200000            # context window before compaction
# CONVERSATION_IDLE_TIMEOUT=300        # seconds before a conversation is considered ended
# CHANNEL_CONTEXT_CAPACITY=2000        # messages buffered in RAM per channel (lost on restart)
# CHANNEL_CONTEXT_RETENTION_SECS=2592000  # drop buffered messages older than this (30 days)

# Optional: chat rate limiting (per user, sliding window)
# CHAT_RATE_LIMIT_MAX=20          # max messages allowed per window (default 20)
# CHAT_RATE_LIMIT_WINDOW_SECS=60  # window size in seconds (default 60)

# Sentry — optional error tracking for the normal chatbot (not deployment-bot)
SENTRY_DSN=https://your-dsn@sentry.io/your-project
# SENTRY_ENVIRONMENT=production

# GitHub App — for filing issues (feature requests + Sentry-backed error reports)
# All four required to enable GitHub issue creation.
# 1. Create a GitHub App at https://github.com/settings/apps/new
#    Permissions: Issues → Read & Write
# 2. Generate a private key (PEM), paste it below with literal \n between lines
# 3. Install the app on the target repo, then grab the Installation ID from
#    https://github.com/settings/installations → your app → URL ends in /<id>
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
# GITHUB_INSTALLATION_ID=12345678
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=master
# GITHUB_TOKEN=ghp_...   # falls back to this when the App credentials are absent

# Automated feature development — OpenCode is the only dispatch backend.
# The defaults let the owner dispatch without walking the interactive picker.
# DEVELOPMENT_DEFAULT_AGENT=opencode
# DEVELOPMENT_DEFAULT_MODEL=opencode/deepseek-v4-flash-free
# DEVELOPMENT_DEFAULT_EFFORT=medium
# DEVELOPMENT_APPROVAL_CHANNEL_ID=       # fallback channel for approval cards
# DEVELOPMENT_APPROVAL_EXPIRY_SECS=3600  # how long an approval card stays valid
# DEVELOPMENT_PENDING_GLOBAL_MAX=10      # concurrent pending jobs across all users
# DEVELOPMENT_REQUEST_RATE_LIMIT_MAX=2           # non-owner requests per window
# DEVELOPMENT_REQUEST_RATE_LIMIT_WINDOW_SECS=3600
# Shared with the dispatch workflow, which signs the completion webhook. Without
# it the bot cannot verify who a completion notice is for and will not DM.
# DEV_NOTIFY_SIGNING_KEY=

# SearXNG — self-hosted metasearch used by the web_search tool.
# The instance must have the JSON format enabled (search.formats: [html, json]).
SEARXNG_URL=http://searxng:8080
# SEARXNG_LANGUAGE=en          # default search language (optional)
# SEARXNG_SAFE_SEARCH=moderate # OFF | moderate | STRICT
