{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "housebot chart values",
  "type": "object",
  "properties": {
    "bot": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0, "maximum": 1 },
        "existingSecret": { "type": "string" },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClassName": { "type": "string" }
          }
        }
      }
    },
    "sandboxApi": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "token": { "type": "string" }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "createNamespace": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "idleTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "runtimeClassName": {
          "type": "string",
          "description": "Empty removes the gVisor boundary; only for clusters without runsc."
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "cnpgCluster": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "dnsNamespace": { "type": "string", "minLength": 1 },
        "botEgressPorts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    }
  }
}
