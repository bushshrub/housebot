{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "housebot chart values",
  "type": "object",
  "properties": {
    "bot": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "existingSecret": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "waitForDatabase": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "sandboxApi": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "token": {
              "type": "string"
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "createNamespace": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "idleTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "runtimeClassName": {
          "type": "string",
          "description": "Empty removes the gVisor boundary; only for clusters without runsc."
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Literal libpq URI; the chart stores it in a Secret."
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "description": "Postgres host; setting it selects the discrete source."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "passwordSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "cnpgCluster": {
          "type": "string"
        },
        "cnpg": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "imageName": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "enablePodAntiAffinity": {
              "type": "boolean"
            },
            "storage": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1
        },
        "botEgressPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "databasePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "databaseEgressCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
